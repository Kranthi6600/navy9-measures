generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Admin {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String?
  passwordHash String
  createdAt    DateTime @default(now())
}

model Customer {
  id            String    @id @default(uuid())
  name          String
  mobile        String    @unique
  email         String?
  dateOfBirth   DateTime?
  height        Float? // total inches (entered as feet + inches)
  weight        Float? // in kg
  photoUrl      String? // Cloudinary URL
  photoPublicId String? // Cloudinary public id, used to delete/replace the photo
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  orders        Order[]

  @@index([name])
}

model Order {
  id          String   @id @default(uuid())
  orderNumber String   @unique // e.g., "636"
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id])
  entryDate   DateTime @default(now())

  // CHANGED FROM FLOAT TO DECIMAL
  totalAmount   Decimal? @db.Decimal(10, 2)
  advanceAmount Decimal? @db.Decimal(10, 2)
  balanceAmount Decimal? @db.Decimal(10, 2)

  blazerM  Measurement? @relation("BlazerMeasurements")
  trouserM Measurement? @relation("TrouserMeasurements")
  shirtM   Measurement? @relation("ShirtMeasurements")

  items OrderItem[]
}

model Measurement {
  id String @id @default(uuid())

  // Shared fields
  size     String?
  length   Float?
  chest    Float?
  waist    Float?
  hip      Float?
  shoulder Float?
  slLength Float?
  armhole  Float?
  biceps   Float?

  // Blazer/Waistcoat specific
  neck     Float?
  fabricNo String?

  // Trousers specific
  thighs Float?
  knees  Float?
  bottom Float?
  fc     Float? // F.C
  bc     Float? // B.C
  hw     Float? // H.W
  lw     Float? // L.W

  // Shirt specific
  pocket String?

  comment String?

  blazerOrderId String? @unique
  blazerOrder   Order?  @relation("BlazerMeasurements", fields: [blazerOrderId], references: [id], onDelete: Cascade)

  trouserOrderId String? @unique
  trouserOrder   Order?  @relation("TrouserMeasurements", fields: [trouserOrderId], references: [id], onDelete: Cascade)

  shirtOrderId String? @unique
  shirtOrder   Order?  @relation("ShirtMeasurements", fields: [shirtOrderId], references: [id], onDelete: Cascade)
}

model OrderItem {
  id      String @id @default(uuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product String // Blazer, Trousers, Shirt, Tie/Bow

  // CHANGED FROM FLOAT TO DECIMAL
  rate     Decimal @db.Decimal(10, 2)
  quantity Int
  amount   Decimal @db.Decimal(10, 2)
}
