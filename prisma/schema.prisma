generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Admin {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String?
  passwordHash String
  createdAt    DateTime @default(now())
}

model Customer {
  id             String    @id @default(uuid())
  customerNumber String    @unique // e.g., "CUST-0001"
  name           String
  mobile        String    @unique
  email         String?
  dateOfBirth   DateTime?
  height        Float? // total inches (entered as feet + inches)
  weight        Float? // in kg
  photoUrl      String? // Cloudinary URL
  photoPublicId String? // Cloudinary public id, used to delete/replace the photo
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  orders        Order[]

  blazerM    Measurement? @relation("BlazerMeasurements")
  waistcoatM Measurement? @relation("WaistcoatMeasurements")
  trouserM   Measurement? @relation("TrouserMeasurements")
  shirtM     Measurement? @relation("ShirtMeasurements")

  @@index([name])
}

model Order {
  id          String   @id @default(uuid())
  orderNumber String   @unique // e.g., "636"
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id])
  entryDate   DateTime @default(now())

  // CHANGED FROM FLOAT TO DECIMAL
  totalAmount   Decimal? @db.Decimal(10, 2)
  advanceAmount Decimal? @db.Decimal(10, 2)
  balanceAmount Decimal? @db.Decimal(10, 2)

  taxRate   Float? // GST rate as a percent, e.g., 18 for 18%
  taxAmount Decimal? @db.Decimal(10, 2)

  items OrderItem[]
}

model Measurement {
  id String @id @default(uuid())

  // Shared fields
  size     String?
  length   Float?
  chest    Float?
  waist    Float?
  hip      Float?
  shoulder Float?
  slLength Float?
  armhole  Float?
  biceps   Float?

  // Blazer/Waistcoat specific
  neck     Float?
  fabricNo String?

  // Trousers specific
  thighs Float?
  knees  Float?
  bottom Float?
  fc     Float? // F.C
  bc     Float? // B.C
  hw     Float? // H.W
  lw     Float? // L.W

  // Shirt specific
  pocket String?

  comment String?

  blazerCustomerId String? @unique
  blazerCustomer   Customer? @relation("BlazerMeasurements", fields: [blazerCustomerId], references: [id], onDelete: Cascade)

  waistcoatCustomerId String? @unique
  waistcoatCustomer   Customer? @relation("WaistcoatMeasurements", fields: [waistcoatCustomerId], references: [id], onDelete: Cascade)

  trouserCustomerId String? @unique
  trouserCustomer   Customer? @relation("TrouserMeasurements", fields: [trouserCustomerId], references: [id], onDelete: Cascade)

  shirtCustomerId String? @unique
  shirtCustomer   Customer? @relation("ShirtMeasurements", fields: [shirtCustomerId], references: [id], onDelete: Cascade)
}

model OrderItem {
  id      String @id @default(uuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product String // Blazer, Trousers, Shirt, Tie/Bow

  // CHANGED FROM FLOAT TO DECIMAL
  rate     Decimal @db.Decimal(10, 2)
  quantity Int
  amount   Decimal @db.Decimal(10, 2)
}
